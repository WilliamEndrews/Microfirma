{
  "name": "microfirma",
  "private": true,
  "version": "0.0.0",
  "description": "MicroFirma - plano de controle espacial para sistemas agenticos",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --filter @microfirma/demo dev",
    "dev:server": "pnpm --filter @microfirma/server dev",
    "dev:landing": "pnpm --filter @microfirma/landing dev",
    "dev:debugpreview": "pnpm --filter @microfirma/debugpreview dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab:iso": "node scripts/iso-validation/lab-server.mjs",
    "relatorio:postos": "node scripts/relatorio-postos-trabalho.mjs",
    "load-test": "npm exec --yes --package=tsx@4.19.2 -- tsx scripts/load-test.ts",
    "telemetria:dry": "npm exec --yes --package=tsx@4.19.2 -- tsx scripts/enviar-telemetria-agencia.ts --dry-run",
    "telemetria:enviar": "npm exec --yes --package=tsx@4.19.2 -- tsx scripts/enviar-telemetria-agencia.ts",
    "test:debugpreview": "vitest run --root apps/debugpreview",
    "contracts:jsonschema": "pnpm --filter @microfirma/contracts gen:jsonschema"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
