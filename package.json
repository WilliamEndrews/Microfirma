{
  "name": "microfirma",
  "private": true,
  "version": "0.0.0",
  "description": "MicroFirma - plano de controle espacial para sistemas agenticos",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --filter @microfirma/demo dev",
    "dev:server": "pnpm --filter @microfirma/server dev",
    "dev:landing": "pnpm --filter @microfirma/landing dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "load-test": "npx tsx scripts/load-test.ts",
    "contracts:jsonschema": "pnpm --filter @microfirma/contracts gen:jsonschema"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
